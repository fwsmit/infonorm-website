---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckList from '../components/CheckList.astro';
import ContactCard from '../components/ContactCard.astro';
import { emailLinks, site } from '../data/site';

const title = `Contact — ${site.name}`;
const description = `Neem contact op met ${site.name} in ${site.city}. Mail ${site.email} voor een gratis adviesgesprek over IT, automatisering of energiebeheer.`;

const topics = [
  'Een gratis adviesgesprek over zonnepanelen en het einde van de salderingsregeling',
  'Een tweede mening over een IT-offerte of leverancier',
  'Een terugkerend klusje dat geautomatiseerd kan worden',
  'Iets anders — ook dan hoor ik het graag',
];
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={`Contact — ${site.name}`}
  ogDescription={`Mail ${site.email} voor een gratis en vrijblijvend adviesgesprek.`}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Neem contact op</h1>
      <p class="lede">
        Een vraag, een idee of gewoon even sparren? Mail gerust. U krijgt meestal
        binnen één werkdag antwoord.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div class="prose">
          <h2>Waar kan ik u mee helpen?</h2>
          <p>
            Of het nu gaat om een IT-vraagstuk, een plan voor uw zonnepanelen of iets
            waarvan u nog niet precies weet hoe het op te lossen: stuur een bericht en
            we kijken samen verder.
          </p>

          <CheckList items={topics} class="checklist--spaced" />

          <h2>Handig om te vermelden</h2>
          <p>
            Voor een eerste gesprek is het fijn als u kort aangeeft waar u woont, wat
            uw vraag is en — bij energie — welke apparatuur u al heeft. Merk en type
            van de omvormer of een foto van de meterkast zeggen vaak al veel.
          </p>
          <p>
            Liever bellen? Stuur een e-mail met uw telefoonnummer, dan bel ik u terug.
          </p>
        </div>

        <ContactCard
          title="Direct contact"
          intro="De snelste manier om mij te bereiken is per e-mail."
          emailHref={emailLinks.advice}
        >
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            <span><strong>E-mail</strong>{site.email}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            <span><strong>Locatie</strong>{site.location}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-9A8.4 8.4 0 1 1 21 11.5Z"></path><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5"></path></svg>
            <span><strong>WhatsApp</strong>{site.whatsapp}</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            <span><strong>Eerste gesprek</strong>Gratis en vrijblijvend</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.19 1.46-2.19 2.97V21h-4V9Z"></path></svg>
            <span><strong>LinkedIn</strong><a href={site.linkedin.url} target="_blank" rel="noopener noreferrer">{site.linkedin.label}</a></span>
          </li>
        </ContactCard>
      </div>
    </div>
  </section>
</BaseLayout>

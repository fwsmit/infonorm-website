---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import CheckList from '../components/CheckList.astro';
import ContactCard from '../components/ContactCard.astro';
import { emailLinks, site } from '../data/site';

const title = `Salderingsregeling stopt in 2027 — ${site.name}`;
const description = `Per 1 januari 2027 stopt de salderingsregeling. Ontdek wat er verandert en hoe u uw eigen zonne-energie beter kunt gebruiken. Gratis adviesgesprek in ${site.city}.`;

const options = [
  '<strong>Beoordelen of een thuisbatterij zin heeft</strong> — onafhankelijk advies voor uw situatie.',
  '<strong>Verbruik verschuiven naar zonne-uren</strong> — denk aan de warmtepomp of boiler.',
  '<strong>Sturen op eigen opwek en verbruik</strong> — met bestaande apparatuur waar dat kan.',
];
---

<BaseLayout
  title={title}
  description={description}
  ogTitle="Per 1 januari 2027 stopt de salderingsregeling"
  ogDescription="Zonnepanelen? Zelf opgewekte stroom wordt na 2026 belangrijker. Onafhankelijk advies over slim energiebeheer."
  ogType="article"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Zonnepanelen &amp; energiebeheer</span>
      <h1>Heeft u zonnepanelen? Per 1 januari 2027 stopt de salderingsregeling.</h1>
      <p class="lede">
        Terugleveren aan het net levert vanaf dan veel minder op. De stroom die u
        zelf gebruikt, wordt juist meer waard. Hieronder leest u wat er verandert en
        wat u kunt doen.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-2 grid-start grid-gap-xl">
        <div class="prose">
          <h2>Wat verandert er?</h2>
          <p>
            Tot nu toe kunt u de stroom die u teruglevert verrekenen met de stroom die
            u verbruikt. Dat stopt op <strong>1 januari 2027</strong>. Teruglevering
            aan het net levert dan veel minder op dan nu.
          </p>
          <p>
            Daarom loont het om de stroom van uw eigen zonnepanelen zelf te gebruiken,
            op het moment dat u hem opwekt of later op de dag.
          </p>

          <div class="note">
            <p>
              <strong>Goed om te weten:</strong> uw zonnepanelen blijven gewoon
              stroom opwekken. Alleen de manier waarop teruggeleverde stroom wordt
              verrekend, verandert.
            </p>
          </div>

          <h2>Waar kunnen wij bij helpen?</h2>
          <p>
            De beste aanpak verschilt per huishouden. Dit zijn een aantal dingen waar wij bij kunnen helpen:
          </p>
          <CheckList items={options} class="checklist--spaced" />

        </div>

        <ContactCard
          title="Plan een gratis adviesgesprek"
          intro={`Vrijblijvend, bij u thuis in ${site.serviceArea}. We kijken samen wat er nodig is — en wat vooral niet.`}
          date="1 januari 2027"
          buttonHref="/contact"
          buttonLabel="Naar contact"
        />
      </div>
    </div>
  </section>

  <!-- <CallToAction href="/contact" label="Naar contact"> -->
  <!--   <strong>Niet zeker of dit voor u geldt?</strong> Mail uw vraag — ik denk graag mee. -->
  <!-- </CallToAction> -->
</BaseLayout>

---
import { site } from '../data/site';

interface Props {
  title: string;
  intro: string;
  emailHref?: string;
  buttonHref?: string;
  date?: string;
  buttonLabel?: string;
}

const {
  title,
  intro,
  emailHref,
  buttonHref = emailHref,
  date,
  buttonLabel = emailHref ? 'Stuur een e-mail' : 'Naar contact',
} = Astro.props;
---

<aside class="contact-card" aria-labelledby="contact-card-title">
  {date && <span class="panel-date">{date}</span>}
  <h2 id="contact-card-title">{title}</h2>
  <p>{intro}</p>
  {emailHref && <a class="mail-link" href={emailHref}>{site.email}</a>}
  {buttonHref && <a class="btn btn-solar" href={buttonHref}>{buttonLabel}</a>}

  {Astro.slots.has('default') && (
    <ul class="contact-list">
      <slot />
    </ul>
  )}
</aside>

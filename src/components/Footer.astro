---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label={`${site.name} — naar de homepage`}>
          <img class="brand-logo" src="/logo.svg" alt="" width="52" height="52" />
        </a>
        <p>Onafhankelijk IT- en energieadvies uit {site.city}. Persoonlijk, nuchter en zonder onnodige abonnementen.</p>
      </div>

      <div>
        <h3>Navigatie</h3>
        <ul>
          <li><a href="/#diensten">Diensten</a></li>
          <li><a href="/salderingsregeling">Zonnepanelen</a></li>
          <li><a href="/over-mij">Over mij</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name} · {site.owner.name}</span>
    </div>
  </div>
</footer>
